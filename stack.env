# TUPA and Compose configuration template. Copy to .env and uncomment values to override.
# TZ is the container timezone; compose passes the host TZ value through by default.
# Leave TUPA_TZ unset (or empty) to use the system timezone.

# PUBLISH_IP=127.0.0.1
# PUBLISH_PORT=8000

# TZ=UTC
# RES_OPTIONS=timeout:1 attempts:1
# TUPA_TZ=America/Argentina/Buenos_Aires
# TUPA_MEMBERS=edenor,edesur
# TUPA_SOURCES=edenor,edesur
# TUPA_SERVE=true
# TUPA_HOST=0.0.0.0
# TUPA_PORT=8000
# TUPA_TIMEOUT=10
# TUPA_TTL=60
# TUPA_FORMAT=json
# TUPA_INDENT=2
# TUPA_CONFIG=
# TUPA_STRICT=false
# TUPA_CUSTOMERS=edenor=3400000,edesur=2700000,edelap=400000
# TUPA_LEVELS=0.0001,0.005,0.05
# TUPA_DEMAND_LEVELS=0.15,0.30,0.50
