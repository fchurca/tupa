# TUPA and Compose configuration template. Copy to .env and uncomment values to override.
# Most users do not need to change anything: defaults are intended to work.
# TZ comes from the shell/.env and defaults to ART; TUPA_TZ unset uses TZ.
# TUPA_MEMBERS selects from the built-in members; it is trimmed, and empty means all.

# PUBLISH_IP=127.0.0.1
# PUBLISH_PORT=8000

# TZ=America/Argentina/Buenos_Aires
# RES_OPTIONS=timeout:1 attempts:1
# TUPA_TZ=America/Argentina/Buenos_Aires
# TUPA_MEMBERS=edenor,edesur
# TUPA_SERVE=true
# TUPA_HOST=0.0.0.0
# TUPA_PORT=8000
# TUPA_TIMEOUT=10
# TUPA_TTL=60
# TUPA_FORMAT=json
# TUPA_INDENT=2
# TUPA_CONFIG=
# TUPA_STRICT=false
# TUPA_CUSTOMERS=edenor=3400000,edesur=2700000,edelap=400000
# TUPA_LEVELS=0.0001,0.005,0.05
# TUPA_DEMAND_LEVELS=0.15,0.30,0.50
