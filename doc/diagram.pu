@startuml
top to bottom direction
skinparam shadowing false

rectangle "ENRE\nOutage data" as ENRE
rectangle "CAMMESA\nDemand data" as CAMMESA
rectangle "OCEBA\nProvincial outage data" as OCEBA

rectangle "Edenor\nDistribution" as EDENOR
rectangle "Edesur\nDistribution" as EDESUR
rectangle "Edelap\nDistribution" as EDELAP

ENRE ..> EDENOR
ENRE ..> EDESUR
CAMMESA ..> EDENOR
CAMMESA ..> EDESUR
CAMMESA ..> EDELAP
OCEBA ..> EDELAP
@enduml

