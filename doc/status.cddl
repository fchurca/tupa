; TUPA status — CDDL
;
; The status is the machine-facing value; color is a display hint only:
;   operational -> green   no or minor outages
;   warn        -> yellow  service notably degraded
;   high        -> orange  service significantly affected
;   disaster    -> red     major parts of the service down or completely offline
;   unknown     -> grey    datasource not available/datasource offline but service not confirmed down

status = "operational" / "warn" / "high" / "disaster" / "unknown"

; Timestamp: ISO 8601 / RFC 3339, e.g. 2026-11-21T13:45:30-03:00
;   [0-9]{4}-[0-9]{2}-[0-9]{2}   date (YYYY-MM-DD)
;   T                           date/time separator
;   [0-9]{2}:[0-9]{2}:[0-9]{2}   time (HH:MM:SS)
;   (Z|[+-][0-9]{2}:[0-9]{2})   UTC "Z" or ±HH:MM offset
timestamp = text .regexp "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})"

member = {
  updated: timestamp,
  status: status,
  ? comment: text,
}

system = {
  updated: timestamp,
  members: { * text => member }
}

